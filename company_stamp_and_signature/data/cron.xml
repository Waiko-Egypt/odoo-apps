<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 18 — Cron job for stamp/signature expiry warnings -->
<odoo>

    <!--
        Daily cron: checks each company's stamp and signature expiry dates.
        If either is exactly stamp_expiry_warning_days days away, posts a
        chatter notification on the company record and mentions all
        Stamp & Signature Managers.
    -->
    <record id="cron_check_stamp_expiry" model="ir.cron">
        <field name="name">Company Stamp &amp; Signature: Check Expiry Dates</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_stamp_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
