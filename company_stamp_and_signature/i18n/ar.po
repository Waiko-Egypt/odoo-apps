msgid "Display Settings"
msgstr "إعدادات العرض"

msgid "⚠ The current stamp has expired — it will not print on documents. Please update or remove the expiry date."
msgstr "⚠ انتهت صلاحية الختم الحالي — لن يُطبع على المستندات. يرجى تحديث تاريخ الانتهاء أو إزالته."

msgid "⚠ Stamp has expired — it will not print until you update or remove the expiry date."
msgstr "⚠ انتهت صلاحية الختم — لن يُطبع حتى تقوم بتحديث تاريخ الانتهاء أو إزالته."

msgid "Save"
msgstr "حفظ"

msgid "Discard"
msgstr "تجاهل"

msgid "Open Full Settings →"
msgstr "فتح الإعدادات الكاملة ←"

