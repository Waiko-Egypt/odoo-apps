msgid "⚠ Stamp expiry date has passed — stamp will not appear on documents until you remove or update the expiry date."
msgstr "⚠ تجاوز الختمُ تاريخ انتهاء صلاحيته — لن يظهر على المستندات حتى تقوم بإزالة تاريخ الانتهاء أو تحديثه."

# ── View strings — hr.employee tab ───────────────────────────────────────────

msgid "Personal Signature"
msgstr "التوقيع الشخصي"

msgid "Signature"
msgstr "التوقيع"

msgid ""
"This signature is printed on quotations and invoices on which this employee "
"is the responsible salesperson, instead of the company signature (as long as "
"the corresponding \"Print Signature On\" option is enabled in the company's "
"Stamp & Signature settings)."
msgstr ""
"يُطبع هذا التوقيع على عروض الأسعار والفواتير التي يكون هذا الموظف مسؤولاً "
"عن مبيعاتها، بدلاً من توقيع الشركة، طالما أن خيار «طباعة التوقيع على» "
"المقابل مفعّل في إعدادات الختم والتوقيع للشركة."

