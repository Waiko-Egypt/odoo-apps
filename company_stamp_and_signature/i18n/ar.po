msgstr "إعدادات الختم والتوقيع"

# ── Validation errors — res.company ──────────────────────────────────────────

msgid "Stamp opacity must be between 0.1 and 1.0."
msgstr "يجب أن تكون شفافية الختم بين 0.1 و 1.0."

msgid "Signature opacity must be between 0.1 and 1.0."
msgstr "يجب أن تكون شفافية التوقيع بين 0.1 و 1.0."

msgid "Stamp width and height must be at least 10 pixels."
msgstr "يجب أن لا يقل عرض الختم وارتفاعه عن 10 بكسل."

msgid "Signature width and height must be at least 10 pixels."
msgstr "يجب أن لا يقل عرض التوقيع وارتفاعه عن 10 بكسل."

msgid "Stamp rotation must be between 0 and 360 degrees."
msgstr "يجب أن تكون قيمة دوران الختم بين 0 و 360 درجة."

# ── Validation errors — stamp.signature.wizard ───────────────────────────────

msgid ""
"You have enabled printing the stamp on one or more documents, but no stamp "
"image has been uploaded.\n"
"\n"
"Please upload a stamp image or disable all 'Print Stamp On' options."
msgstr ""
"لقد قمت بتفعيل طباعة الختم على مستند أو أكثر، لكن لم يتم رفع صورة الختم "
"بعد.\n"
"\n"
"يرجى رفع صورة الختم أو تعطيل جميع خيارات «طباعة الختم على»."

msgid ""
"You have enabled printing the signature on one or more documents, but no "
"signature image has been uploaded.\n"
"\n"
"Please upload a signature image or disable all 'Print Signature On' options."
msgstr ""
"لقد قمت بتفعيل طباعة التوقيع على مستند أو أكثر، لكن لم يتم رفع صورة "
"التوقيع بعد.\n"
"\n"
"يرجى رفع صورة التوقيع أو تعطيل جميع خيارات «طباعة التوقيع على»."

# ── Validation errors — hr.employee ──────────────────────────────────────────

msgid "Signature opacity must be between 0.1 and 1.0."
msgstr "يجب أن تكون شفافية التوقيع بين 0.1 و 1.0."

msgid "Signature width and height must be at least 10 pixels."
msgstr "يجب أن لا يقل عرض التوقيع وارتفاعه عن 10 بكسل."
