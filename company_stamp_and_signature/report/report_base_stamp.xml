<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared stamp + signature base block — used by all four per-document templates.

    Callers MUST set these variables before calling this template:
        company            res.company record
        employee           hr.employee record (or False)
        personal_signature result of employee._get_document_signature() (or False)
        print_stamp_flag   Boolean — company.print_stamp_on_<doctype>
        print_sig_flag     Boolean — company.print_signature_on_<doctype>

    Keeping the rendering logic here avoids repeating it in every report file.
    To change stamp/signature appearance for all documents, edit only this file.
-->
<odoo>

    <template id="stamp_signature_base_block">

        <t t-set="stamp_class"
           t-value="'text-start' if company.stamp_position == 'left' else ('text-end' if company.stamp_position == 'right' else 'text-center')"/>
        <t t-set="sig_class"
           t-value="'text-start' if company.signature_position == 'left' else ('text-end' if company.signature_position == 'right' else 'text-center')"/>

        <!-- ── Stamp ──────────────────────────────────────────────────────── -->
        <t t-if="company.company_stamp and print_stamp_flag and not company.stamp_is_expired">
            <t t-if="company.stamp_as_watermark">
                <!-- Watermark: centered full-page background -->
                <div t-attf-style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(#{company.stamp_rotation}deg); z-index: 0; pointer-events: none; text-align: center;">
                    <img t-att-src="'data:image/png;base64,{}'.format(company.company_stamp)"
                         t-attf-style="width: #{company.stamp_width}px; height: #{company.stamp_height}px; opacity: #{company.stamp_opacity};"
                         alt="Company Stamp Watermark"/>
                </div>
            </t>
            <t t-else="">
                <!-- Normal corner position with rotation applied to image -->
                <div t-att-class="stamp_class" style="margin-top: 20px; margin-bottom: 8px;">
                    <img t-att-src="'data:image/png;base64,{}'.format(company.company_stamp)"
                         t-attf-style="width: #{company.stamp_width}px; height: #{company.stamp_height}px; opacity: #{company.stamp_opacity}; transform: rotate(#{company.stamp_rotation}deg);"
                         alt="Company Stamp"/>
                </div>
            </t>
        </t>

        <!-- ── Signature ──────────────────────────────────────────────────── -->
        <t t-if="print_sig_flag and not company.signature_is_expired">
            <t t-if="personal_signature">
                <!-- Employee personal signature (overrides company signature) -->
                <t t-set="emp_pos" t-value="personal_signature['position']"/>
                <t t-set="emp_sig_class"
                   t-value="'text-start' if emp_pos == 'left' else ('text-end' if emp_pos == 'right' else 'text-center')"/>
                <div t-att-class="emp_sig_class" style="margin-top: 8px;">
                    <img t-att-src="'data:image/png;base64,{}'.format(personal_signature['image'])"
                         t-attf-style="width: #{personal_signature['width']}px; height: #{personal_signature['height']}px; opacity: #{personal_signature['opacity']}; transform: rotate(#{personal_signature.get('rotation', 0)}deg);"
                         t-attf-alt="#{employee.name} Signature"/>
                    <t t-if="personal_signature.get('label')">
                        <div style="font-size: 11px; margin-top: 2px;">
                            <t t-esc="personal_signature['label']"/>
                        </div>
                    </t>
                </div>
            </t>
            <t t-elif="company.company_signature">
                <!-- Company signatures with rotation support -->
                <div t-att-class="sig_class" style="margin-top: 8px;">
                    <img t-att-src="'data:image/png;base64,{}'.format(company.company_signature)"
                         t-attf-style="width: #{company.signature_width}px; height: #{company.signature_height}px; opacity: #{company.signature_opacity}; transform: rotate(#{company.signature_rotation}deg);"
                         alt="Company Signature"/>
                    <t t-if="company.show_signatory_label and company.authorized_signatory_label">
                        <div style="font-size: 11px; margin-top: 2px;">
                            <t t-esc="company.authorized_signatory_label"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>

    </template>

</odoo>
