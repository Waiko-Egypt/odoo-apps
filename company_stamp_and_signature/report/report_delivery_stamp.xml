<?xml version="1.0" encoding="utf-8"?>
<!-- Delivery Note — delegates rendering to the shared base block. Odoo 18 -->
<odoo>

    <template id="stamp_delivery_block">
        <t t-set="company"            t-value="doc.company_id"/>
        <t t-set="employee"           t-value="doc.user_id.employee_id if doc.user_id else False"/>
        <t t-set="personal_signature" t-value="employee._get_document_signature() if employee else False"/>
        <t t-set="print_stamp_flag"   t-value="company.print_stamp_on_delivery"/>
        <t t-set="print_sig_flag"     t-value="company.print_signature_on_delivery"/>
        <t t-call="company_stamp_and_signature.stamp_signature_base_block"/>
    </template>

</odoo>
