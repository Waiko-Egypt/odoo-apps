<?xml version="1.0" encoding="utf-8"?>
<!-- Invoice / Bill — delegates rendering to the shared base block. Odoo 18 -->
<odoo>

    <template id="stamp_invoice_block">
        <t t-set="company"            t-value="o.company_id"/>
        <t t-set="employee"           t-value="o.invoice_user_id.employee_id"/>
        <t t-set="personal_signature" t-value="employee._get_document_signature() if employee else False"/>
        <t t-set="print_stamp_flag"   t-value="company.print_stamp_on_invoice"/>
        <t t-set="print_sig_flag"     t-value="company.print_signature_on_invoice"/>
        <t t-call="company_stamp_and_signature.stamp_signature_base_block"/>
    </template>

    <template id="report_invoice_document_stamp"
              inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="company_stamp_and_signature.stamp_invoice_block"/>
        </xpath>
    </template>

</odoo>
