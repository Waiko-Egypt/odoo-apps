<?xml version="1.0" encoding="utf-8"?>
<!-- Sale Order / Quotation — delegates rendering to the shared base block. Odoo 18 -->
<odoo>

    <template id="stamp_sale_block">
        <t t-set="company"            t-value="doc.company_id"/>
        <t t-set="employee"           t-value="doc.user_id.employee_id"/>
        <t t-set="personal_signature" t-value="employee._get_document_signature() if employee else False"/>
        <t t-set="print_stamp_flag"   t-value="company.print_stamp_on_quotation"/>
        <t t-set="print_sig_flag"     t-value="company.print_signature_on_quotation"/>
        <t t-call="company_stamp_and_signature.stamp_signature_base_block"/>
    </template>

    <template id="report_saleorder_document_stamp"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="company_stamp_and_signature.stamp_sale_block"/>
        </xpath>
    </template>

</odoo>
