<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 19 — enhanced: per-employee signatory label -->
<odoo>

    <record id="view_employee_signature_form" model="ir.ui.view">
        <field name="name">hr.employee.signature.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Personal Signature" name="personal_signature">

                    <group>
                        <field name="use_personal_signature"/>
                    </group>

                    <group string="Signature" invisible="use_personal_signature == False">
                        <group>
                            <field name="employee_signature"
                                   widget="image"
                                   string="Signature Image"
                                   options="{'size': [200, 100]}"
                                   filename="employee_signature_filename"/>
                            <field name="employee_signature_filename" invisible="True"/>
                        </group>
                        <group>
                            <field name="employee_signature_width" string="Width (px)"/>
                            <field name="employee_signature_height" string="Height (px)"/>
                            <field name="employee_signature_opacity"
                                   string="Opacity (0.1 – 1.0)"/>
                            <field name="employee_signature_position" string="Position"/>
                            <field name="employee_signature_rotation" string="Rotation (°)"/>
                            <field name="employee_signatory_label"
                                   string="Signatory Label"
                                   placeholder="Overrides company label (optional)"/>
                        </group>
                    </group>

                    <div class="text-muted" invisible="use_personal_signature == False">
                        This signature is printed on quotations and invoices
                        on which this employee is the responsible
                        salesperson, instead of the company signature
                        (as long as the corresponding "Print Signature On" option
                        is enabled in the company's Stamp &amp; Signature settings).
                    </div>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
