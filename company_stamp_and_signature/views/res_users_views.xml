<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 19 — full personal signature preferences for every user -->
<odoo>

    <record id="view_users_form_my_signature" model="ir.ui.view">
        <field name="name">res.users.preferences.my.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <group string="My Signature" name="my_signature"
                      invisible="employee_id == False">

                    <!-- Toggle -->
                    <field name="use_personal_signature"/>

                    <!-- Image + properties — shown only when toggle is on -->
                    <group invisible="use_personal_signature == False">
                        <group string="Signature Image">
                            <field name="employee_signature"
                                   widget="image"
                                   string="Signature Image"
                                   options="{'size': [220, 110]}"
                                   filename="employee_signature_filename"/>
                            <field name="employee_signature_filename" invisible="True"/>
                        </group>
                        <group string="Display Settings">
                            <field name="employee_signature_width"  string="Width (px)"/>
                            <field name="employee_signature_height" string="Height (px)"/>
                            <field name="employee_signature_opacity"
                                   string="Opacity (0.1 – 1.0)"/>
                            <field name="employee_signature_position" string="Position"/>
                            <field name="employee_signature_rotation" string="Rotation (°)"/>
                            <field name="employee_signatory_label"
                                   string="Signatory Label"
                                   placeholder="e.g. Sales Manager (optional)"/>
                        </group>
                    </group>

                    <div class="text-muted small" invisible="use_personal_signature == False">
                        This signature is printed on documents where you are
                        the responsible salesperson, instead of the company signature,
                        as long as the corresponding "Print Signature On" option is
                        enabled in the company's Stamp &amp; Signature settings.
                    </div>

                </group>
            </xpath>

        </field>
    </record>

</odoo>
