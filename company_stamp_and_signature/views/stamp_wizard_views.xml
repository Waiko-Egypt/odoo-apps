<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 19 — Stamp & Signature wizard -->
<odoo>

    <!-- ── Wizard View ────────────────────────────────────────────────────── -->
    <record id="view_stamp_signature_wizard_form" model="ir.ui.view">
        <field name="name">stamp.signature.wizard.form</field>
        <field name="model">stamp.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Stamp &amp; Signature">
                <sheet>

                    <!-- hidden computed flags used by alert banners -->
                    <field name="stamp_is_expired" invisible="True"/>
                    <field name="signature_is_expired" invisible="True"/>

                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="stamp_is_expired == False">
                        The current stamp has expired — it will not print on documents.
                        Please update or remove the expiry date.
                    </div>

                    <notebook>

                        <!-- ══════════════ STAMP TAB ══════════════ -->
                        <page string="Company Stamp" name="stamp_tab">
                            <group>

                                <group string="Stamp Image">
                                    <field name="company_stamp"
                                           widget="image"
                                           string="Upload Stamp"
                                           options="{'size': [220, 220]}"
                                           filename="company_stamp_filename"
                                           nolabel="1"/>
                                    <field name="company_stamp_filename" invisible="True"/>
                                </group>

                                <group string="Display Settings">
                                    <field name="stamp_width"        string="Width (px)"/>
                                    <field name="stamp_height"       string="Height (px)"/>
                                    <field name="stamp_opacity"      string="Opacity (0.1 – 1.0)"/>
                                    <field name="stamp_position"     string="Position"/>
                                    <field name="stamp_rotation"     string="Rotation (°)"/>
                                    <field name="stamp_as_watermark" string="Use as Watermark"/>
                                    <field name="stamp_expiry_date"  string="Expiry Date"/>
                                </group>

                            </group>

                            <group string="Print Stamp On">
                                <field name="print_stamp_on_quotation" string="Quotations / Sale Orders"/>
                                <field name="print_stamp_on_invoice"   string="Invoices"/>
                                <field name="print_stamp_on_delivery"  string="Delivery Notes"/>
                                <field name="print_stamp_on_purchase"  string="Purchase Orders"/>
                            </group>
                        </page>

                        <!-- ══════════════ SIGNATURE TAB ══════════════ -->
                        <page string="Company Signature" name="signature_tab">
                            <group>

                                <group string="Signature Image">
                                    <field name="company_signature"
                                           widget="image"
                                           string="Upload Signature"
                                           options="{'size': [220, 110]}"
                                           filename="company_signature_filename"
                                           nolabel="1"/>
                                    <field name="company_signature_filename" invisible="True"/>
                                </group>

                                <group string="Display Settings">
                                    <field name="signature_width"    string="Width (px)"/>
                                    <field name="signature_height"   string="Height (px)"/>
                                    <field name="signature_opacity"  string="Opacity (0.1 – 1.0)"/>
                                    <field name="signature_position" string="Position"/>
                                    <field name="signature_rotation" string="Rotation (°)"/>
                                    <field name="signature_expiry_date" string="Expiry Date"/>
                                </group>

                            </group>

                            <div class="alert alert-warning mb-3" role="alert"
                                 invisible="signature_is_expired == False">
                                The current signature has expired — it will not print on documents.
                                Please update or remove the expiry date.
                            </div>

                            <group string="Authorized Signatory">
                                <field name="show_signatory_label" string="Show Label Below Signature"/>
                                <field name="authorized_signatory_label"
                                       string="Label Text"
                                       invisible="show_signatory_label == False"
                                       placeholder="e.g. Authorized Signatory / General Manager"/>
                            </group>

                            <group string="Print Signature On">
                                <field name="print_signature_on_quotation" string="Quotations / Sale Orders"/>
                                <field name="print_signature_on_invoice"   string="Invoices"/>
                                <field name="print_signature_on_delivery"  string="Delivery Notes"/>
                                <field name="print_signature_on_purchase"  string="Purchase Orders"/>
                            </group>
                        </page>

                        <!-- ══════════════ NOTIFICATIONS TAB ══════════════ -->
                        <page string="Notifications" name="notifications_tab">
                            <group string="Expiry Warning">
                                <field name="stamp_expiry_warning_days"
                                       string="Warn (days before expiry)"
                                       help="A chatter notification is sent to all Stamp &amp; Signature Managers this many days before the stamp or signature expires. Set to 0 to disable."/>
                            </group>
                        </page>

                    </notebook>
                </sheet>

                <footer>
                    <button string="Save" type="object" name="action_save"
                            class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                    <button string="Open Full Settings" type="object"
                            name="action_open_company_settings"
                            class="btn-link ms-auto"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Action to open the wizard ─────────────────────────────────────── -->
    <record id="action_stamp_signature_wizard" model="ir.actions.act_window">
        <field name="name">Upload Stamp &amp; Signature</field>
        <field name="res_model">stamp.signature.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_company"/>
        <field name="binding_view_types">list,form</field>
    </record>


</odoo>
