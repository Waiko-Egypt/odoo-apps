<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_product_image_reports" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.product.image.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Product Images"
                     string="Product Images"
                     name="product_image_reports">
                    <block title="Product Images in Reports"
                           name="product_image_reports_settings">
                        <setting id="show_product_image_in_reports_setting"
                                 string="Show Product Image in Reports"
                                 help="Display the product image in quotation, sale order, and invoice reports.">
                            <field name="show_product_image_in_reports"/>
                            <div class="content-group mt16"
                                 invisible="not show_product_image_in_reports">
                                <div class="row mt16">
                                    <label for="product_image_width"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="product_image_width" class="oe_inline"/>
                                    <span class="col-form-label ms-2">px width</span>
                                </div>
                                <div class="row mt8">
                                    <label for="product_image_height"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="product_image_height" class="oe_inline"/>
                                    <span class="col-form-label ms-2">px height</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
