<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The report functionality does not require an extra image column in the
        sale order editor. This inherited view is intentionally inactive to
        avoid duplicating an image column supplied by another installed view.
        Keeping the same XML ID also deactivates the view during module upgrade.
    -->
    <record id="view_order_form_inherit_product_image" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.product.image</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='order_line']/tree//field[@name='product_id'])[1]" position="after">
                <field name="product_image" widget="image"
                       options="{'size': [40, 40]}"
                       string="Image"
                       readonly="1"
                       nolabel="1"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
